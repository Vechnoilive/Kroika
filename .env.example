# Безопасная конфигурация этапа 10. Реальных ключей в репозитории нет.
KROIKA_DATABASE_PATH=data/kroika.db
KROIKA_IMAGE_STORAGE_PATH=data/images
KROIKA_AI_PROVIDER=mock
KROIKA_AI_TIMEOUT_SECONDS=45
KROIKA_AI_MAX_ATTEMPTS=2
KROIKA_MAX_IMAGE_BYTES=10485760
KROIKA_LOG_LEVEL=INFO
KROIKA_DEBUG=false
KROIKA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ключ и endpoint должны относиться к одному региону Alibaba Model Studio.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3-vl-plus

# Используйте Gemini только в официально доступном для вашей учётной записи регионе.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
