{
  "name": "kroika-frontend",
  "private": true,
  "version": "0.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:stage11": "vitest run src/ProjectWorkflow.test.tsx src/Stage11Preview.test.tsx",
    "test:stage12": "vitest run src/Stage12Garments.test.tsx",
    "test:stage13": "vitest run src/Stage13Jacket.test.tsx",
    "test:stage14": "vitest run src/Stage14LowerGarments.test.tsx",
    "test:stage15": "vitest run src/Stage15Accessibility.test.tsx",
    "test:stage16": "vitest run src/Stage16DesignIntent.test.tsx",
    "test:stage17": "vitest run src/Stage17DesignReview.test.tsx",
    "test:stage18": "vitest run src/Stage18Modeling.test.tsx",
    "test:stage19": "vitest run src/Stage19Composites.test.tsx",
    "test:stage20": "vitest run src/Stage20Coverage.test.tsx",
    "test:stage21": "vitest run src/Stage21Topology.test.tsx",
    "test:stage22": "vitest run src/Stage22PhysicalValidation.test.tsx",
    "e2e": "playwright test --grep-invert @qwen-live",
    "e2e:stage12": "playwright test e2e/stage12-garments.spec.ts",
    "e2e:stage13": "playwright test e2e/stage13-jacket.spec.ts",
    "e2e:stage14": "playwright test e2e/stage14-lower-garments.spec.ts",
    "e2e:qwen": "playwright test --grep @qwen-live",
    "typecheck": "tsc -b --pretty false",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "jsdom": "30.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
