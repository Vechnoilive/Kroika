{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kroika.local/schemas/v1/pattern-engine-result.schema.json",
  "title": "Pattern engine result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "project_id", "generation_id", "input_hash", "engine_version", "pattern_method", "created_at", "status", "pattern", "validation_report"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "request_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "project_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "generation_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "input_hash": {"$ref": "common.schema.json#/$defs/sha256"},
    "engine_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "pattern_method": {"$ref": "common.schema.json#/$defs/pattern_method"},
    "created_at": {"$ref": "common.schema.json#/$defs/date_time"},
    "status": {"type": "string", "enum": ["succeeded", "rejected"]},
    "pattern": {"oneOf": [{"$ref": "pattern-data.schema.json"}, {"type": "null"}]},
    "validation_report": {"$ref": "validation-report.schema.json"}
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]},
    "then": {"properties": {"pattern": {"$ref": "pattern-data.schema.json"}}}
  }]
}
