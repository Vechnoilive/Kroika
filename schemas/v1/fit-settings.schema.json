{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kroika.local/schemas/v1/fit-settings.schema.json",
  "title": "FitSettings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "settings_id", "status", "preset", "wearing_ease_mm", "design_ease_mm", "distribution", "seam_allowance_mode", "seam_allowances_mm", "confirmed_at"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "settings_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "status": {"type": "string", "enum": ["draft", "confirmed"]},
    "preset": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "wearing_ease_mm": {"$ref": "#/$defs/ease_values"},
    "design_ease_mm": {"$ref": "#/$defs/ease_values"},
    "distribution": {
      "type": "object", "additionalProperties": false,
      "required": ["front_share", "back_share"],
      "properties": {
        "front_share": {"type": "number", "minimum": 0, "maximum": 1},
        "back_share": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "seam_allowance_mode": {"type": "string", "enum": ["none", "by_edge"]},
    "seam_allowances_mm": {
      "type": "object", "additionalProperties": false,
      "required": ["normal", "neckline", "armhole", "zipper", "hem", "sleeve_hem", "fold"],
      "properties": {
        "normal": {"$ref": "common.schema.json#/$defs/millimetres"},
        "neckline": {"$ref": "common.schema.json#/$defs/millimetres"},
        "armhole": {"$ref": "common.schema.json#/$defs/millimetres"},
        "zipper": {"$ref": "common.schema.json#/$defs/millimetres"},
        "hem": {"$ref": "common.schema.json#/$defs/millimetres"},
        "sleeve_hem": {"$ref": "common.schema.json#/$defs/millimetres"},
        "fold": {"type": "number", "const": 0}
      }
    },
    "confirmed_at": {"anyOf": [{"$ref": "common.schema.json#/$defs/date_time"}, {"type": "null"}]}
  },
  "$defs": {
    "ease_values": {
      "type": "object", "additionalProperties": false,
      "required": ["bust", "waist", "hips", "upper_arm"],
      "properties": {
        "bust": {"$ref": "common.schema.json#/$defs/millimetres"},
        "waist": {"$ref": "common.schema.json#/$defs/millimetres"},
        "hips": {"$ref": "common.schema.json#/$defs/millimetres"},
        "upper_arm": {"$ref": "common.schema.json#/$defs/millimetres"}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"status": {"const": "confirmed"}}, "required": ["status"]},
    "then": {"properties": {"confirmed_at": {"$ref": "common.schema.json#/$defs/date_time"}}},
    "else": {"properties": {"confirmed_at": {"type": "null"}}}
  }]
}
