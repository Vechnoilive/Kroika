{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kroika.local/schemas/v1/ai-analysis-request.schema.json",
  "title": "AI style analysis request v1",
  "description": "Запрос содержит только изображения и словарь поддержанных признаков; мерки тела запрещены структурой.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "project_id", "locale", "image_refs", "supported_garment_categories", "supported_features", "image_transmission_confirmed"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "request_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "project_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "locale": {"type": "string", "const": "ru-RU"},
    "image_refs": {
      "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^img_[a-zA-Z0-9_-]{8,80}$"}
    },
    "image_views": {
      "description": "Подписанные пользователем виды в том же порядке, что image_refs.",
      "type": "array", "minItems": 1, "maxItems": 4,
      "items": {"type": "string", "enum": ["front", "back", "side", "detail", "flat_sketch", "unknown"]}
    },
    "supported_garment_categories": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "enum": ["dress", "sundress", "skirt", "top", "blouse", "shirt", "vest", "blazer", "jacket", "trousers", "shorts", "jumpsuit", "light_coat"]}
    },
    "supported_features": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {
        "type": "array", "minItems": 1, "uniqueItems": true,
        "items": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "image_transmission_confirmed": {"type": "boolean", "const": true}
  }
}
