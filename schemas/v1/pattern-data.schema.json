{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kroika.local/schemas/v1/pattern-data.schema.json",
  "title": "Canonical pattern geometry contract v1",
  "description": "Формат геометрии ядра этапа 9. Координаты и размеры только в миллиметрах.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "unit", "pieces", "seam_pairs"],
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/$defs/schema_version"},
    "unit": {"type": "string", "const": "mm"},
    "pieces": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/pattern_piece"}
    },
    "seam_pairs": {
      "type": "array",
      "items": {"$ref": "#/$defs/seam_pair"}
    },
    "modeling_operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/modeling_operation"}
    },
    "topology_operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/topology_operation"}
    },
    "composite_operations": {
      "type": "array",
      "items": {"$ref": "#/$defs/composite_operation"}
    },
    "manual_adjustments": {"$ref": "#/$defs/manual_adjustments"},
    "design_coverage": {"$ref": "#/$defs/design_coverage"},
    "print_layout": {
      "type": "object", "additionalProperties": false,
      "required": ["page_format", "page_width_mm", "page_height_mm", "margin_mm", "overlap_mm", "scale", "control_square_mm"],
      "properties": {
        "page_format": {"type": "string", "const": "A4"},
        "page_width_mm": {"type": "number", "const": 210},
        "page_height_mm": {"type": "number", "const": 297},
        "margin_mm": {"type": "number", "minimum": 5, "maximum": 15},
        "overlap_mm": {"type": "number", "minimum": 5, "maximum": 20},
        "scale": {"type": "number", "const": 1},
        "control_square_mm": {"type": "number", "const": 50}
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false
    },
    "line_segment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "start", "end"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "type": {"type": "string", "const": "line"},
        "start": {"$ref": "#/$defs/point"},
        "end": {"$ref": "#/$defs/point"}
      }
    },
    "cubic_bezier_segment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "start", "control_1", "control_2", "end"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "type": {"type": "string", "const": "cubic_bezier"},
        "start": {"$ref": "#/$defs/point"},
        "control_1": {"$ref": "#/$defs/point"},
        "control_2": {"$ref": "#/$defs/point"},
        "end": {"$ref": "#/$defs/point"}
      }
    },
    "arc_segment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "type", "start", "end", "radius_x_mm", "radius_y_mm", "rotation_deg", "large_arc", "sweep"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "type": {"type": "string", "const": "arc"},
        "start": {"$ref": "#/$defs/point"},
        "end": {"$ref": "#/$defs/point"},
        "radius_x_mm": {"$ref": "common.schema.json#/$defs/positive_millimetres"},
        "radius_y_mm": {"$ref": "common.schema.json#/$defs/positive_millimetres"},
        "rotation_deg": {"type": "number"},
        "large_arc": {"type": "boolean"},
        "sweep": {"type": "boolean"}
      }
    },
    "segment": {
      "oneOf": [
        {"$ref": "#/$defs/line_segment"},
        {"$ref": "#/$defs/cubic_bezier_segment"},
        {"$ref": "#/$defs/arc_segment"}
      ]
    },
    "path": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "closed", "segments"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "closed": {"type": "boolean"},
        "segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segment"}}
      }
    },
    "closed_contour": {
      "allOf": [
        {"$ref": "#/$defs/path"},
        {"properties": {"closed": {"const": true}}}
      ]
    },
    "grainline": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {"start": {"$ref": "#/$defs/point"}, "end": {"$ref": "#/$defs/point"}}
    },
    "notch": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "segment_id", "distance_from_start_mm", "kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "match_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "segment_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "distance_from_start_mm": {"$ref": "common.schema.json#/$defs/millimetres"},
        "kind": {"type": "string", "enum": ["single", "double", "triple"]}
      }
    },
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text_ru", "position"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "text_ru": {"type": "string", "minLength": 1, "maxLength": 250},
        "position": {"$ref": "#/$defs/point"}
      }
    },
    "pattern_piece": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name_ru", "cut_quantity", "cut_on_fold", "mirrored_pair", "seam_contour", "cutting_contour", "internal_paths", "grainline", "notches", "annotations"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "name_ru": {"type": "string", "minLength": 1, "maxLength": 120},
        "cut_quantity": {"type": "integer", "minimum": 1, "maximum": 20},
        "cut_on_fold": {"type": "boolean"},
        "mirrored_pair": {"type": "boolean"},
        "seam_contour": {"$ref": "#/$defs/closed_contour"},
        "cutting_contour": {"oneOf": [{"$ref": "#/$defs/closed_contour"}, {"type": "null"}]},
        "edge_allowances": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["segment_id", "edge_type", "allowance_mm"],
            "properties": {
              "segment_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
              "edge_type": {"type": "string", "enum": ["normal", "neckline", "armhole", "zipper", "hem", "sleeve_hem", "fold"]},
              "allowance_mm": {"$ref": "common.schema.json#/$defs/millimetres"}
            }
          }
        },
        "internal_paths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "grainline": {"$ref": "#/$defs/grainline"},
        "notches": {"type": "array", "items": {"$ref": "#/$defs/notch"}},
        "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}}
      }
    },
    "seam_pair": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "first_piece_id", "first_segment_ids", "second_piece_id", "second_segment_ids", "first_length_reduction_mm", "second_length_reduction_mm", "allowed_ease_mm", "tolerance_mm"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "first_piece_id": {"type": "string"},
        "first_segment_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "second_piece_id": {"type": "string"},
        "second_segment_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "first_length_reduction_mm": {"$ref": "common.schema.json#/$defs/millimetres"},
        "second_length_reduction_mm": {"$ref": "common.schema.json#/$defs/millimetres"},
        "allowed_ease_mm": {"$ref": "common.schema.json#/$defs/millimetres"},
        "tolerance_mm": {"$ref": "common.schema.json#/$defs/millimetres"}
      }
    },
    "modeling_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "source_element_id", "kind", "module_id", "formula_id", "target_piece_ids", "parameters_mm", "invariant_residual_mm"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "source_element_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "kind": {"type": "string", "enum": ["pleat", "gather", "flounce", "waistband", "belt", "hem_adjustment"]},
        "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "formula_id": {"type": "string", "pattern": "^M18-[A-Z][0-9]{2}$"},
        "target_piece_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}},
        "parameters_mm": {"type": "object", "additionalProperties": {"type": "number"}},
        "invariant_residual_mm": {"type": "number", "minimum": 0}
      }
    },
    "composite_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "source_kind", "source_id", "kind", "module_id", "formula_id", "target_piece_ids", "added_piece_ids", "interface_ids", "parameters_mm", "invariant_residual_mm"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "source_kind": {"type": "string", "enum": ["element", "layer"]},
        "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "kind": {"type": "string", "enum": ["cuff", "collar", "patch_pocket", "lining", "overlay"]},
        "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "formula_id": {"type": "string", "pattern": "^M19-[A-Z][0-9]{2}$"},
        "target_piece_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}},
        "added_piece_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}},
        "interface_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}},
        "parameters_mm": {"type": "object", "additionalProperties": {"type": "number"}},
        "invariant_residual_mm": {"type": "number", "minimum": 0}
      }
    },
    "topology_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "source_element_id", "kind", "module_id", "formula_id", "target_piece_ids", "parameters_mm", "invariant_residual_mm"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "source_element_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "kind": {"type": "string", "enum": ["yoke", "panels", "dart_transfer"]},
        "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "formula_id": {"type": "string", "pattern": "^M21-[A-Z][0-9]{2}$"},
        "target_piece_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}},
        "parameters_mm": {"type": "object", "additionalProperties": {"type": "number"}},
        "invariant_residual_mm": {"type": "number", "minimum": 0}
      }
    },
    "manual_point_edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["piece_id", "segment_id", "handle", "before", "after", "distance_mm"],
      "properties": {
        "piece_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "segment_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "handle": {"type": "string", "enum": ["end", "control_1", "control_2"]},
        "before": {"$ref": "#/$defs/point"},
        "after": {"$ref": "#/$defs/point"},
        "distance_mm": {"type": "number", "minimum": 0, "maximum": 50}
      }
    },
    "manual_adjustments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "base_generation_id", "note", "edits"],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0.0"},
        "base_generation_id": {"$ref": "common.schema.json#/$defs/uuid"},
        "note": {"type": "string", "maxLength": 500},
        "edits": {
          "type": "array", "minItems": 1, "maxItems": 100,
          "items": {"$ref": "#/$defs/manual_point_edit"}
        }
      }
    },
    "design_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "modules", "physical_validation_required"],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0.0"},
        "modules": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/design_coverage_module"}
        },
        "physical_validation_required": {"type": "boolean", "const": true}
      }
    },
    "design_coverage_module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "source_ids", "evidence"],
      "properties": {
        "module_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "source_ids": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
        },
        "evidence": {"$ref": "#/$defs/design_coverage_evidence"}
      }
    },
    "design_coverage_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["piece_ids", "seam_pair_ids", "path_ids", "segment_ids", "operation_ids"],
      "properties": {
        "piece_ids": {"$ref": "#/$defs/evidence_ids"},
        "seam_pair_ids": {"$ref": "#/$defs/evidence_ids"},
        "path_ids": {"$ref": "#/$defs/evidence_ids"},
        "segment_ids": {"$ref": "#/$defs/evidence_ids"},
        "operation_ids": {"$ref": "#/$defs/evidence_ids"}
      }
    },
    "evidence_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
    }
  }
}
